# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# Supabase > Connect > ใช้ "Session pooler" (ไม่ใช่ Direct / Transaction)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# สุ่มตัวอักษรยาว ๆ อย่างน้อย 32 ตัว
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
PORT=8080
